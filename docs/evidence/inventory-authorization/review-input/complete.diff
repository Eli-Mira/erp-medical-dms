+"""Real-PostgreSQL controls for explicit branch grants, not fulfillment routes."""
+
+from datetime import date
+from uuid import UUID, uuid4
+
+import pytest
+from sqlalchemy import text
+
+pytest_plugins = ["test_inventory_api"]
+
