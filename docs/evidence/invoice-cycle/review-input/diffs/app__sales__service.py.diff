+def reverse_invoice_atomic(db, invoice_id, actor_id, reason_id):
+    """Reverse a Posted invoice atomically (append-only compensating entries):
+
+    1. stock: record 'return' movements (+qty) for each line;
+    2. AR: create a 'credit_note' credit entry equal to grand_total;
+    3. flip invoice to Voided with void metadata.
+
+    All in the caller's transaction. Prevents reversal if Active receipts exist.
+    """
+    invoice = _lock_invoice(db, invoice_id)
+    if invoice is None:
+        return None
+    if invoice["posting_status"] != "Posted":
+        raise ValueError("Only a Posted invoice can be reversed")
+    # Active receipts check
+    active = db.execute(
+        text(
+            "SELECT COALESCE(SUM(amount), 0) FROM finance.payment_receipt "
+            "WHERE invoice_id=:i AND status='Active'"
+        ),
+        {"i": invoice_id},
+    ).scalar()
+    if active and active > 0:
+        raise ValueError("Active receipts exist; void them first")
+
+    movements = list(
+        db.execute(
+            text(
+                "SELECT * FROM inventory.stock_movement WHERE source_type='invoice' "
+                "AND source_id=:i AND movement_type='sale' ORDER BY product_id,batch_id NULLS FIRST,id"
+            ),
+            {"i": invoice_id},
+        ).mappings()
+    )
+    lines = _lines(db, invoice_id)
+    if len(movements) != len(lines) or not movements:
+        raise ValueError("Original stock posting does not reconcile")
+    line_map = {line["id"]: line for line in lines}
+    for movement in movements:
+        line = line_map.get(movement["invoice_line_id"])
+        if (
+            line is None
+            or movement["product_id"] != line["product_id"]
+            or movement["batch_id"] != line["batch_id"]
+            or movement["warehouse_id"] != invoice["warehouse_id"]
+            or movement["quantity"] != -line["quantity"]
+        ):
+            raise ValueError("Original stock posting does not reconcile")
+    debit = (
+        db.execute(
+            text(
+                "SELECT * FROM finance.ar_entry WHERE invoice_id=:i AND entry_type='invoice'"
+            ),
+            {"i": invoice_id},
+        )
+        .mappings()
+        .one_or_none()
+    )
+    if (
+        debit is None
+        or debit["customer_id"] != invoice["customer_id"]
+        or debit["debit"] != invoice["grand_total"]
+        or debit["credit"] != 0
+    ):
+        raise ValueError("Original receivables posting does not reconcile")
+    for movement in movements:
+        inventory.record_movement(
+            db,
+            actor_id=actor_id,
+            warehouse_id=movement["warehouse_id"],
+            product_id=movement["product_id"],
+            batch_id=movement["batch_id"],
+            movement_type="return",
+            quantity=-movement["quantity"],
+            unit_cost=movement["unit_cost"],
+            source_type="invoice",
+            source_id=invoice_id,
+            reverses_movement_id=movement["id"],
+            note="Invoice reversal",
+        )
+    finance.record_entry(
+        db,
+        customer_id=debit["customer_id"],
+        invoice_id=invoice_id,
+        entry_type="credit_note",
+        debit=0,
+        credit=debit["debit"],
+        on_date=db.execute(text("SELECT CURRENT_DATE")).scalar_one(),
+        reason_id=reason_id,
+        reverses_entry_id=debit["id"],
+        note="Invoice reversal",
+        actor_id=actor_id,
+    )
+    db.execute(
+        text("""
+        UPDATE sales.sales_invoice
+           SET posting_status='Voided', voided_at=now(), voided_by=:actor,
+               void_reason_id=:reason, updated_by=:actor, updated_at=now(),
+               version=version+1
+         WHERE id=:id
+    """),
+        {"actor": actor_id, "reason": reason_id, "id": invoice_id},
+    )
+    updated = _lock_invoice(db, invoice_id)
+    return dict(updated)
